Import('*')

if not env['CONF']['USE_LVX_ISA']:
    Return()

env.TagImplies('lvx isa', 'gem5 lib')
env.TagImplies('isa', 'lvx isa')

Source('isa.cc', tags=['lvx isa'])
Source('decoder.cc', tags=['lvx isa'])
Source('static_inst.cc', tags=['lvx isa'])

# Layer B runtime shim: implements the MDS core helpers (operand/register/
# storage access) against a gem5 ThreadContext; the C behavior.c calls these.
Source('shim.cc', tags=['lvx isa'])

# MDS-generated instruction decode + behavior, plus its runtime, compiled as C
# (the generated bodies use `this` as an ordinary parameter name). Regenerate
# with generated/regen.sh; these files are gitignored (Kalray-copyright output).
Source('generated/Decode.c', tags=['lvx isa'])
Source('generated/behavior.c', tags=['lvx isa'])

# Operand decoder (Layer C): fills the behavior's decoded[] from the syllables,
# reusing the MDS Operand/RegClass/Immediate tuples. Compiled as C.
Source('operands.c', tags=['lvx isa'])

SimObject('LvxISA.py', sim_objects=['LvxISA'], tags=['lvx isa'])
SimObject('LvxDecoder.py', sim_objects=['LvxDecoder'], tags=['lvx isa'])

# SE-mode workload + process (Layer D): load an LVX ELF and run it.
Source('process.cc', tags=['lvx isa'])
Source('se_workload.cc', tags=['lvx isa'])
SimObject('LvxSeWorkload.py', sim_objects=['LvxSEWorkload'], tags=['lvx isa'])

# Minimal SE-mode MMU + TLB (header-only C++), so a CPU can be built.
SimObject('LvxMMU.py', sim_objects=['LvxTLB', 'LvxMMU'], tags=['lvx isa'])
SimObject('LvxInterrupts.py', sim_objects=['LvxInterrupts'], tags=['lvx isa'])

# Per-ISA CPU bindings (ArchISA/MMU/Interrupts/Decoder). Pure-Python; the
# concrete Lvx*SimpleCPU classes come from the 'isa'-tagged base CPU objects.
SimObject('LvxCPU.py', sim_objects=[], tags=['lvx isa'])

DebugFlag('LvxRegs', tags=['lvx isa'])
DebugFlag('LvxDecode', tags=['lvx isa'])

# Added incrementally as the port is built up (Phase 1):
#   process.cc / LvxSeWorkload.py - SE-mode process/ABI, scall -> SyscallDesc
#   reg_abi.cc                    - kv4-v1 ABI arg/return conventions
#   faults.cc                     - fault/trap handling
#   remote_gdb.cc                 - GDB stub
#   LvxMMU.py / LvxInterrupts.py / LvxCPU.py - to run (not just link)
